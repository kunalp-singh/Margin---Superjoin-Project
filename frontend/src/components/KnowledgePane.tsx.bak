'use client';

import React, { useState } from 'react';
import { Search, Check, AlertTriangle, Scale, HelpCircle, Layers, GitCompare, FileText } from 'lucide-react';
import { FactItem, RelationshipItem, DocumentItem } from '../lib/types';

interface KnowledgePaneProps {
  facts: FactItem[];
  relationships: RelationshipItem[];
  documents: DocumentItem[];
  selectedFactId: string | null;
  selectedRelationshipId: string | null;
  activeFilter: string;
  onSelectFact: (factId: string) => void;
  onSelectRelationship: (rel: RelationshipItem) => void;
  onFilterChange: (filter: string) => void;
}

const relTypeConfig = {
  corroborated: {
    icon: Check,
    label: 'Corroborated',
    pill: 'bg-rel-corroborated-bg text-rel-corroborated-fg border-rel-corroborated-border',
  },
  contradicted: {
    icon: AlertTriangle,
    label: 'Contradicted',
    pill: 'bg-rel-contradiction-bg text-rel-contradiction-fg border-rel-contradiction-border',
  },
  reconciled: {
    icon: Scale,
    label: 'Reconciled',
    pill: 'bg-rel-reconciled-bg text-rel-reconciled-fg border-rel-reconciled-border',
  },
  uncertain: {
    icon: HelpCircle,
    label: 'Uncertain',
    pill: 'bg-rel-uncertain-bg text-rel-uncertain-fg border-rel-uncertain-border',
  },
};

export const KnowledgePane: React.FC<KnowledgePaneProps> = ({
  facts,
  relationships,
  documents,
  selectedFactId,
  selectedRelationshipId,
  activeFilter,
  onSelectFact,
  onSelectRelationship,
  onFilterChange,
}) => {
  const [searchTerm, setSearchTerm] = useState('');
  const [showDocs, setShowDocs] = useState(false);

  const filterTabs = [
    { id: 'all', label: 'All Facts', icon: Layers, count: facts.length },
    { id: 'corroborated', label: 'Corroborated', icon: Check, count: relationships.filter(r => r.type === 'corroborated').length },
    { id: 'contradicted', label: 'Contradicted', icon: AlertTriangle, count: relationships.filter(r => r.type === 'contradicted').length },
    { id: 'reconciled', label: 'Reconciled', icon: Scale, count: relationships.filter(r => r.type === 'reconciled').length },
    { id: 'uncertain', label: 'Uncertain', icon: HelpCircle, count: facts.filter(f => f.status === 'uncertain').length + relationships.filter(r => r.type === 'uncertain').length },
  ];

  const isRelView = ['corroborated', 'contradicted', 'reconciled'].includes(activeFilter);

  const filteredFacts = facts.filter(f => {
    const q = searchTerm.toLowerCase();
    const textMatch = !q ||
      f.source_quote.toLowerCase().includes(q) ||
      f.normalized_signature.toLowerCase().includes(q) ||
      JSON.stringify(f.attributes).toLowerCase().includes(q);
    if (!textMatch) return false;
    if (activeFilter === 'all') return true;
    if (activeFilter === 'uncertain') return f.status === 'uncertain';
    return false;
  });

  const filteredRelationships = relationships.filter(r => {
    if (activeFilter === 'all') return true;
    return r.type === activeFilter;
  });

  return (
    <aside className="w-[280px] min-w-[260px] border-r border-paper-border bg-paper-surface flex flex-col h-[calc(100vh-3.5rem)]">
      {/* Search */}
      <div className="px-3 pt-3 pb-2 border-b border-paper-border">
        <div className="relative">
          <Search className="w-3.5 h-3.5 absolute left-2.5 top-2.5 text-paper-slate" />
          <input
            type="text"
            placeholder="Search facts…"
            value={searchTerm}
            onChange={e => setSearchTerm(e.target.value)}
            className="w-full bg-paper-bg border border-paper-border rounded px-2.5 py-2 pl-8 text-xs text-paper-ink focus:outline-none focus:border-paper-accent placeholder:text-paper-slate/60"
          />
        </div>
      </div>

      {/* Filter tabs */}
      <div className="px-2 py-2 border-b border-paper-border flex flex-wrap gap-1">
        {filterTabs.map(tab => {
          const Icon = tab.icon;
          const active = activeFilter === tab.id;
          return (
            <button
              key={tab.id}
              onClick={() => onFilterChange(tab.id)}
              className={`text-[11px] px-2 py-1 rounded flex items-center gap-1 transition font-medium ${
                active
                  ? 'bg-paper-ink text-paper-surface'
                  : 'text-paper-slate hover:text-paper-ink hover:bg-paper-bg'
              }`}
            >
              <Icon className="w-3 h-3 shrink-0" />
              <span>{tab.label}</span>
              <span className={`ml-0.5 text-[10px] px-1 rounded ${active ? 'bg-white/20 text-white' : 'bg-paper-border/70 text-paper-slate'}`}>
                {tab.count}
              </span>
            </button>
          );
        })}
      </div>

      {/* List */}
      <div className="flex-1 overflow-y-auto">
        {isRelView ? (
          filteredRelationships.length === 0 ? (
            <div className="p-6 text-center text-xs text-paper-slate font-serif italic">
              No {activeFilter} relationships found.
            </div>
          ) : (
            filteredRelationships.map(rel => {
              const cfg = relTypeConfig[rel.type] || relTypeConfig.uncertain;
              const Icon = cfg.icon;
              const isSelected = selectedRelationshipId === rel.id;
              return (
                <button
                  key={rel.id}
                  onClick={() => onSelectRelationship(rel)}
                  className={`w-full text-left px-3 py-3 border-b border-paper-border/60 transition ${
                    isSelected ? 'bg-paper-accent-light border-l-2 border-l-paper-accent' : 'hover:bg-paper-bg'
                  }`}
                >
                  <div className="flex items-center justify-between mb-1.5">
                    <span className={`inline-flex items-center gap-1 text-[10px] font-mono font-semibold uppercase px-1.5 py-0.5 rounded border ${cfg.pill}`}>
                      <Icon className="w-2.5 h-2.5" />
                      {rel.type}
                    </span>
                    <span className="text-[10px] font-mono text-paper-slate">{(rel.confidence * 100).toFixed(0)}%</span>
                  </div>
                  <p className="text-xs font-semibold text-paper-ink capitalize truncate">
                    {rel.fact_a?.attributes?.metric || 'Factual Claim'}
                  </p>
                  <p className="text-[11px] text-paper-slate mt-0.5 line-clamp-2 font-serif leading-snug">
                    "{rel.fact_a?.source_quote}"
                  </p>
                  <div className="mt-1.5 text-[10px] text-paper-slate flex items-center gap-1 font-mono">
                    <span className="truncate max-w-[90px]">{rel.fact_a?.document_filename}</span>
                    <GitCompare className="w-2.5 h-2.5 shrink-0" />
                    <span className="truncate max-w-[90px]">{rel.fact_b?.document_filename}</span>
                  </div>
                </button>
              );
            })
          )
        ) : (
          filteredFacts.length === 0 ? (
            <div className="p-6 text-center text-xs text-paper-slate font-serif italic">
              No facts match current selection.
            </div>
          ) : (
            filteredFacts.map(fact => {
              const isSelected = selectedFactId === fact.id;
              const isUncertain = fact.status === 'uncertain';
              return (
                <button
                  key={fact.id}
                  onClick={() => onSelectFact(fact.id)}
                  className={`w-full text-left px-3 py-3 border-b border-paper-border/60 transition ${
                    isSelected ? 'bg-paper-accent-light border-l-2 border-l-paper-accent' : 'hover:bg-paper-bg'
                  }`}
                >
                  <div className="flex items-center justify-between mb-1">
                    <span className="text-[10px] font-mono text-paper-slate uppercase tracking-wider truncate max-w-[140px]">
                      {fact.attributes?.entity || 'Entity'}
                    </span>
                    {isUncertain ? (
                      <span className="text-[10px] font-mono font-semibold uppercase px-1.5 py-0.5 rounded border bg-rel-uncertain-bg text-rel-uncertain-fg border-rel-uncertain-border">
                        Uncertain
                      </span>
                    ) : (
                      <span className="text-[10px] font-mono text-paper-accent bg-paper-accent-light px-1.5 py-0.5 rounded">
                        p.{fact.page_number}
                      </span>
                    )}
                  </div>
                  <p className="text-xs font-semibold text-paper-ink capitalize truncate">
                    {fact.attributes?.metric || 'Ground Claim'}
                  </p>
                  <p className="text-[11px] text-paper-slate mt-0.5 line-clamp-2 font-serif leading-snug">
                    "{fact.source_quote}"
                  </p>
                  <div className="mt-1.5 text-[10px] text-paper-slate flex items-center justify-between font-mono">
                    <span className="font-semibold text-paper-ink">
                      {fact.attributes?.value}{fact.attributes?.unit ? ` ${fact.attributes.unit}` : ''}
                    </span>
                    <span className="truncate max-w-[110px]">{fact.document_filename}</span>
                  </div>
                </button>
              );
            })
          )
        )}
      </div>

      {/* Sources footer (collapsible) */}
      <div className="border-t border-paper-border">
        <button
          onClick={() => setShowDocs(!showDocs)}
          className="w-full px-3 py-2 flex items-center justify-between text-[11px] text-paper-slate hover:text-paper-ink transition"
        >
          <span className="flex items-center gap-1.5 font-mono uppercase tracking-wider font-medium">
            <FileText className="w-3 h-3" />
            Sources ({documents.length})
          </span>
          <span className="text-[10px]">{showDocs ? '▲' : '▼'}</span>
        </button>
        {showDocs && (
          <div className="px-3 pb-3 space-y-1 max-h-32 overflow-y-auto bg-paper-bg">
            {documents.map(doc => (
              <div key={doc.id} className="flex items-center justify-between text-[11px] text-paper-ink">
                <span className="truncate max-w-[160px]" title={doc.filename}>{doc.filename}</span>
                <span className="text-[10px] font-mono text-paper-slate shrink-0 ml-2">
                  {doc.status === 'done' ? `${doc.fact_count}f` : doc.status}
                </span>
              </div>
            ))}
          </div>
        )}
      </div>
    </aside>
  );
};
